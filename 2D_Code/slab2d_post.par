# 2D slab - POST-ablation fixed settings (openCARP .par file)
# x < 0                 : active CRN tissue                         (tag 1)
# 0 <= x < lesion width : ablation lesion, necrotic, non-conducting (tag 100)
# x >= lesion width     : isolated wall, viable but decoupled by the
#                         lesion, never activated                  (tag 101)
# x = 0 is the lesion edge = Wang's annotated scar boundary.
# Anything also passed on the command line from run.py overrides these.

# ---------------- Physics / numerics ----------------
bidomain     = 0          # monodomain
parab_solve  = 1          # Crank-Nicolson - must match tuneCV --ts
dt           = 25         # us
spacedt      = 0.25       # ms -> 4 kHz Vm output
timedt       = 10         # ms, console progress only

# ---------------- Ionic regions ----------------
num_imp_regions        = 2
imp_region[0].im       = Courtemanche
imp_region[0].num_IDs  = 2
imp_region[0].ID[0]    = 1          # active tissue
imp_region[0].ID[1]    = 101        # isolated wall (sits at prepaced rest)
imp_region[1].im       = Courtemanche
imp_region[1].num_IDs  = 1
imp_region[1].ID[0]    = 100        # lesion (membrane irrelevant once decoupled)
# imp_region[0].im_sv_init is set from run.py (path to the bench state file)

# ---------------- Conductivity regions ----------------
num_gregions        = 2
gregion[0].num_IDs  = 2
gregion[0].ID[0]    = 1             # active tissue
gregion[0].ID[1]    = 101           # isolated wall (same tissue properties)
gregion[1].num_IDs  = 1
gregion[1].ID[0]    = 100           # lesion
# gregion[0]: g_i*/g_e* set from run.py (--gi/--ge, per dx)
# gregion[1]: g_i* = gi * --lesion-g (non-conducting), g_e* = ge (unchanged)

# ---------------- Stimulus (timing / strength) ----------------
num_stim                = 1
stim[0].crct.type       = 0         # transmembrane current
stim[0].pulse.strength  = 150.0     # uA/cm^2 - check capture
stim[0].ptcl.start      = 0.0
stim[0].ptcl.duration   = 2.0       # ms
stim[0].ptcl.npls       = 1
# stim[0].elec.p0/p1 box is set from run.py (depends on sheet size)

# ---------------- Activation times ----------------
num_LATs            = 1
lats[0].ID          = activation
lats[0].all         = 0             # first activation only
lats[0].measurand   = 0             # from Vm
lats[0].mode        = 0
lats[0].threshold   = -10           # mV
