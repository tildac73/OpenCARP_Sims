{
"name": "slab3d_default",
"runs": "../3D_Code/runs/*/*",
"out_dir": "../results",
"seed": 1,
"gain": {
  "mode": "auto",
  "target_bipolar_healthy_mV": 1.44
},
"noise": {
  "mode": "floor",
  "floor_bipolar_mV": 0.04
},
"filters": {
  "unipolar_hz": null,
  "differential_hz": [30, 450],
  "order": 2,
  "zero_phase": false
},
"bipolar_mode": "max_orthogonal",
"woi_ms": null,
"wang_export": {
  "enabled": false
},
"groundtruth": {
  "window_last_ms": 400,
  "placements_xy_mm_pre":  [[-4, 0], [4, 0], [0, 5]],
  "placements_xy_mm_post": [[-4, 0], [4, 0], [0, 5]],
  "map_xy_mm_pre":  [[-4, 0], [4, 0], [0, 5]],
  "map_xy_mm_post": [[-4, 0], [4, 0], [0, 5]]
}
}
