# =====================================================================
# s1_pace.par  -  beats 1-9 at CL 200 ms, checkpoint just before beat 10
# Run:  openCARP +F common.par +F s1_pace.par
# =====================================================================
simID          = out/s1_pace
tend           = 1795          # ms; beat 10 fires at 1800 in s2

num_tsav       = 1
tsav[0]        = 1795
write_statef   = state         # TODO check written name, e.g. state.1795.0.roe
