# =====================================================================
# scar.par  -  overlay that turns any stage into its post-ablation version
# Load AFTER common.par and BEFORE the stage file:
#   openCARP +F common.par +F scar.par +F <stage>.par
#
# Lesion (my choice; the paper does not model ablation):
#   transmural cylinder, radius 2.5 mm, axis along z through x=0, y=0
#   (bundle midpoint) -> fully transects bundle (2.5 mm) + sheath (3 mm)
# Built by run.py into mesh/slab_bundle_scar.elem (same .pts/.lon).
# =====================================================================
meshname                = mesh/slab_bundle_scar

num_gregions            = 5
gregion[4].num_IDs      = 1            # scar: non-conducting
gregion[4].ID[0]        = 5
gregion[4].g_il         = 1e-6
gregion[4].g_it         = 1e-6
gregion[4].g_in         = 1e-6
gregion[4].g_el         = 1e-6
gregion[4].g_et         = 1e-6
gregion[4].g_en         = 1e-6

# Optional border zone (tag 6, e.g. a 1 mm shell; add it in run.py):
# num_gregions            = 6
# gregion[5].num_IDs      = 1
# gregion[5].ID[0]        = 6
