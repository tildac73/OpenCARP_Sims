# =====================================================================
# s2_block.par  -  beat 10 with the bundle exit segment (tag 3) blocked
# Run:  openCARP +F common.par +F s2_block.par
#
# The wave from the pacing site cannot enter the bundle retrogradely
# through the exit; it travels through the wall to the entry end and
# conducts orthodromically along the bundle. The block is lifted at
# T_LIFT (= tend here), before that wave reaches the exit.
#
# T_LIFT window (find it with a dry run, guide section 4):
#   1800 + APD90 of wall beside exit + 10 ms  <  T_LIFT
#   T_LIFT  <  1800 + arrival time at bundle/exit interface - 10 ms
# =====================================================================
simID          = out/s2_block
start_statef   = out/s1_pace/state.1795.0     # TODO exact checkpoint name
tend           = 1950                          # = T_LIFT; TODO set from dry run

# exit segment non-conductive for this stage only
gregion[2].g_il = 1e-6
gregion[2].g_it = 1e-6
gregion[2].g_in = 1e-6
gregion[2].g_el = 1e-6
gregion[2].g_et = 1e-6
gregion[2].g_en = 1e-6

num_tsav       = 1
tsav[0]        = 1950                          # = T_LIFT
write_statef   = state
