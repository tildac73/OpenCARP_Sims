# =====================================================================
# s4_ablate_terminate.par  -  post-ablation A: lesion applied during
#                             sustained reentry; does the driver stop?
# Run:  openCARP +F common.par +F scar.par +F s4_ablate_terminate.par
#
# Same .pts as the pre-ablation mesh, so the nodal checkpoint from s3 is
# valid. If your build refuses the restart because meshname changed,
# put the scar .elem in a separate folder under the original file name
# and point meshname there.
# =====================================================================
simID          = out/s4_ablate_terminate
start_statef   = out/s3_reentry/state.3500.0   # TODO exact checkpoint name
tend           = 6000          # 2.5 s after ablation: termination + quiescence
