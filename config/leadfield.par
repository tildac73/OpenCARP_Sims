# =====================================================================================
# Lead fields and electrograms of every electrode: openCARP's lead-field module (FM-35).
# Requires openCARP >= 20 (released 1 Sep 2026; "Compute lead-field ECGs").
#
# Post-processing only (experiment 4) with post_processing_opts 64 (Leadfield). One run per condition:
#   * every electrode is a lead-field stimulus (crct.type 13, "leadfield stim (extracellular current)"),
#     strength 1 = a total current of 1 uA, which openCARP spreads over the electrode volume
#     (strength x 1e12 / volume, then the mass matrix), with the corner cube grounded (crct.type 3);
#   * openCARP solves the bulk system (g_i + g_e in tissue and lesion, g_bath in the bath) once per
#     electrode and writes the lead field Z on the tissue nodes (LF_<name>.igb);
#   * it streams lf_vmfile (the monodomain vm.igb) and writes V(t) = Z . (K_i Vm(t)) per electrode
#     (ECG_<name>.dat) every ecg_timedt.
# openCARP manual Section 4.2.6 (Eqs. 34-36) and physics/leadfield.cc; example 02_EP_tissue/09_leadfield.
#
# efov/leadfield.py writes the conductivity regions (the model's g_i, g_e, g_bath), the stimuli, the mesh,
# lf_vmfile, ecg_timedt and lf_dir (when the lead fields are cached) into each resolved file.
# =====================================================================================

experiment           = 4          # post process only
post_processing_opts = 64         # Leadfield
bidomain             = 1          # so that K_i is the intracellular (sigma_i) stiffness. In monodomain and
                                  # pseudo-bidomain mode openCARP builds this matrix with the monodomain
                                  # tensor sigma_m (VL-2026-11-01-02), which would bias the source (FM-23).

cg_norm_ellip  = 2        # relative residual. The default (0) is an ABSOLUTE preconditioned residual: on fine
                          # meshes the initial residual is already below it and the solve returns without
                          # iterating (seen with the Laplace mode on a 0.25 mm test box, VL-2026-11-07-01)
cg_tol_ellip   = 1e-10    # relative residual of each lead-field solve
cg_maxit_ellip = 10000

num_imp_regions  = 1
imp_region[0].im = Courtemanche    # EP physics must be active for the lead-field module; not integrated here

num_phys_regions          = 2
phys_region[0].ptype      = 0
phys_region[0].name       = intracellular
phys_region[0].num_IDs    = 2
phys_region[0].ID[0]      = 1
phys_region[0].ID[1]      = 5
phys_region[1].ptype      = 1
phys_region[1].name       = extracellular
phys_region[1].num_IDs    = 3
phys_region[1].ID[0]      = 1
phys_region[1].ID[1]      = 5
phys_region[1].ID[2]      = 0
