# =====================================================================================
# Lead field of one electrode by reciprocity: an openCARP Laplace solve (FM-14).
#
# A total current of 1 uA is injected at the electrode's mesh nodes; the bath corner cube is
# grounded; the potential everywhere is the electrode's lead field z (mV per uA).
#
# The conductivity regions are NOT set here. efov/leadfield.py writes them into each resolved
# lead-field file from the run's resolved model parameters, with every extracellular conductivity
# of tissue and lesion set to g_i + g_e. The Laplace operator is then div((sigma_i + sigma_e) grad),
# the operator of the bidomain extracellular equation. efov/leadfield.py combines the lead field
# with the sigma_i source and the monodomain Vm (FM-23): phi = -z^T S_i Vm, exact for the discrete
# problem div((sigma_i + sigma_e) grad phi_e) = -div(sigma_i grad Vm) with the corner ground.
#
# Basis: openCARP 19.0.0 binary help text (Laplace experiment; "extracellular current (in uA/cm^3)";
# crct.total_current "Treat strengths as total current (uA) and not density") and the openCARP
# Laplace example 02_EP_tissue/13_laplace. Whether the Laplace mode accepts a current stimulus is
# checked by W0 (checks/container_checks.py) before any production run.
# =====================================================================================

experiment   = 2          # Laplace solve only
bidomain     = 1          # required by the Laplace mode (openCARP sets it otherwise, with a warning)
cg_tol_ellip = 1e-10      # relative residual of the Laplace solve
dt           = 20
tend         = 1
timedt       = 1
spacedt      = 1

num_imp_regions  = 1
imp_region[0].im = Courtemanche    # not used by a Laplace solve; kept so the model setup is complete

num_phys_regions          = 2
phys_region[0].ptype      = 0
phys_region[0].name       = intracellular
phys_region[0].num_IDs    = 2
phys_region[0].ID[0]      = 1
phys_region[0].ID[1]      = 5
phys_region[1].ptype      = 1
phys_region[1].name       = extracellular
phys_region[1].num_IDs    = 3
phys_region[1].ID[0]      = 1
phys_region[1].ID[1]      = 5
phys_region[1].ID[2]      = 0

num_stim                     = 2
stim[0].crct.type            = 3      # extracellular ground (corner cube)
stim[1].crct.type            = 1      # extracellular current
stim[1].crct.total_current   = 1      # strength is a total current (uA), not a density
stim[1].pulse.strength       = 1.0    # uA
stim[1].ptcl.start           = 0
stim[1].ptcl.duration        = 1      # ms; as the Laplace example
